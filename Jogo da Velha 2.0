#include <stdio.h>
#include <locale.h>
//Alterações principais - Matriz agora é de char, sistema de pontuação, quem começa, vitória e empate, nome dos jogadores

//Isso aqui detecta se as linhas, colunas e diagonais são iguais pra determinar a vitória
char v(char m[3][3])
{
 int i;
 for(i = 0; i < 3; i++)
    {
     if(m[i][0] == m[i][1] && m[i][1] == m[i][2])
        {
         return m[i][0];
        }
    }

    for(i = 0; i < 3; i++)
    {
     if(m[0][i] == m[1][i] && m[1][i] == m[2][i])
        {
         return m[0][i];
        }
    }

    if(m[0][0] == m[1][1] && m[1][1] == m[2][2])
    {
     return m[0][0];
    }

    if(m[0][2] == m[1][1] && m[1][1] == m[2][0])
    {
     return m[0][2];
    }

    return ' ';
}

//Início normal
int main()
{
    setlocale(LC_ALL, "Portuguese");
    
//Sopa de variável, printf e scanf kkkkkkkkkkkkkkkkkkkkkkk

    char m[3][3];
    int i, j, c, confirmacao, venceu, v1=0, v2=0, comeco;
    char n1[10], n2[10];
    printf("Coloque o nome do Jogador 1: \n");
    scanf("%s", &n1);
    printf("\nColoque o nome do Jogador 2: \n");
    scanf("%s", &n2);
    printf("\nColoque quem começa: %s(1) ou %s(2) \n", n1, n2);
    scanf("%d", &comeco);

    do
    {
        int jogadas = 0;
        int venceu = 0;
        char a = '1';
        for(i = 0; i < 3; i++)
        {
            for(j = 0; j < 3; j++)
            {
                m[i][j] = a++;
            }
        }
        printf("\n");

        for(i = 0; i < 3; i++)
        {
            for(j = 0; j < 3; j++)
            {
                printf(" %c \t", m[i][j]);
            }
            printf("\n");
        }

        printf("\n");

        while(jogadas < 9 && venceu == 0)
        {
            int jogador;
            //Aqui a parte de quem começa
            if(comeco == 1)
              {
               jogador = (jogadas % 2) + 1;
              }
            else
              {
               jogador = (jogadas % 2 == 0) ? 2 : 1;
              }

            char simbolo = (jogador == 1) ? 'X' : 'O';
            
            //Isso é depois de cada jogada
            if(jogador == 1)
             {
              printf("%s (%c): ", n1, simbolo);
             }
            else
             {
              printf("%s (%c): ", n2, simbolo);
             }
            scanf("%d", &c);
            
            switch(c)
            {
                case 1 ... 9:

                    i = (c - 1) / 3;
                    j = (c - 1) % 3;

                    if(m[i][j] == 'X' || m[i][j] == 'O')
                    {
                        printf("\nPode não man\n");
                        printf("\n");
                        for(i = 0; i < 3; i++)
                        {
                            for(j = 0; j < 3; j++)
                            {
                                printf(" %c \t", m[i][j]);
                            }

                            printf("\n");
                        }

            printf("\n");
                    }
                    else
                    {
                        m[i][j] = simbolo;
                        jogadas++;

                        printf("\n");
                        for(i = 0; i < 3; i++)
                        {
                            for(j = 0; j < 3; j++)
                            {
                                printf(" %c \t", m[i][j]);
                            }

                            printf("\n");
                        }
                        printf("\n");

                        // Ele printa quem venceu e adiciona a pontuação
                        char vencedor = v(m);

                        if(vencedor == 'X')
                        {
                            v1++;
                            printf("%s venceu!\n", n1);
                            printf("%s: %d\t", n1, v1);
                            printf("%s: %d\n", n2, v2);
                            venceu = 1;
                        }
                        else if(vencedor == 'O')
                        {
                            v2++;
                            printf("%s venceu!\n", n2);
                            printf("%s: %d\t", n1, v1);
                            printf("%s: %d\n", n2, v2);
                            venceu = 1;
                        }

                        if(jogadas == 9 && venceu == 0)
                        {
                            printf("Empate!\n");
                        }
                        
                    }

                    break;

                default:
                    printf("\nInválido\n");
            }
            
            printf("\n");
                        for(i = 0; i < 3; i++)
                        {
                            for(j = 0; j < 3; j++)
                            {
                                printf(" %c \t", m[i][j]);
                            }

                            printf("\n");
                        }

            printf("\n");
        }
       
        printf("Acabou! Continuar?\n\n");
        printf("1 - Sim\n");
        printf("0 - Não\n\n");

        scanf("%d", &confirmacao);

    } while(confirmacao == 1);
}
